# Copy this file to .env.local to switch the contact form on.
# .env.local is gitignored - your key never goes into the repository.

# The only setting that is actually required.
# Get it from https://resend.com/api-keys after signing up.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where messages land. Defaults to the email in data/site.ts.
CONTACT_TO=michaelpeacock1993@gmail.com

# Who the email appears to be from.
#
# Leave this out to use Resend's shared sender, which needs no DNS setup but
# will only deliver to the address your Resend account was created with.
#
# Once you have verified michaelpeacock.uk in Resend, set it to an address on
# that domain - messages then come from you rather than resend.dev, and are
# much less likely to land in spam:
#
# CONTACT_FROM=Michael Peacock <site@michaelpeacock.uk>
